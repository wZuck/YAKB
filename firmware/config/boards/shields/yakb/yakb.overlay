/* YAKB A0 - engineering prototype; compiled for the pinned target; hardware calibration required. */
#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/adc/adc.h>
#include <zephyr/dt-bindings/adc/nrf-saadc.h>
#include <dt-bindings/zmk/matrix_transform.h>

/ {
    chosen { zmk,kscan = &kscan0; zmk,matrix-transform = &transform0; };
    mux0: mux0 {
        compatible = "zmk,gpio-mux";
        gpio-controller;
        #gpio-cells = <2>;
        select-gpios = <&pro_micro 5 GPIO_ACTIVE_HIGH>, <&pro_micro 6 GPIO_ACTIVE_HIGH>, <&pro_micro 7 GPIO_ACTIVE_HIGH>;
        en-gpios = <&pro_micro 8 GPIO_ACTIVE_LOW>;
    };
    mux1: mux1 {
        compatible = "zmk,gpio-mux";
        gpio-controller;
        #gpio-cells = <2>;
        select-gpios = <&pro_micro 5 GPIO_ACTIVE_HIGH>, <&pro_micro 6 GPIO_ACTIVE_HIGH>, <&pro_micro 7 GPIO_ACTIVE_HIGH>;
        en-gpios = <&pro_micro 9 GPIO_ACTIVE_LOW>;
    };
    transform0: transform0 {
        compatible = "zmk,matrix-transform";
        rows = <5>;
        columns = <15>;
        map = <
            RC(0,0) RC(0,1) RC(0,2) RC(0,3) RC(0,4) RC(0,5) RC(0,6) RC(0,7) RC(0,8) RC(0,9) RC(0,10) RC(0,11) RC(0,12) RC(0,13) RC(0,14)
            RC(1,0) RC(1,2) RC(1,3) RC(1,4) RC(1,5) RC(1,6) RC(1,7) RC(1,8) RC(1,9) RC(1,10) RC(1,11) RC(1,12) RC(1,13) RC(1,14)
            RC(2,0) RC(2,2) RC(2,3) RC(2,4) RC(2,5) RC(2,6) RC(2,7) RC(2,8) RC(2,9) RC(2,10) RC(2,11) RC(2,12) RC(2,13)
            RC(3,1) RC(3,2) RC(3,3) RC(3,4) RC(3,5) RC(3,6) RC(3,7) RC(3,8) RC(3,9) RC(3,10) RC(3,11) RC(3,13) RC(3,14)
            RC(4,2) RC(4,3) RC(4,7) RC(4,10) RC(4,12)
        >;
    };
    kscan0: kscan0 {
        compatible = "zmk,kscan-ec-matrix";
        strobe-gpios = <&pro_micro 0 GPIO_ACTIVE_HIGH>, <&pro_micro 1 GPIO_ACTIVE_HIGH>,
                       <&pro_micro 2 GPIO_ACTIVE_HIGH>, <&pro_micro 3 GPIO_ACTIVE_HIGH>, <&pro_micro 4 GPIO_ACTIVE_HIGH>;
        input-gpios = <&mux0 0 GPIO_ACTIVE_HIGH>, <&mux0 1 GPIO_ACTIVE_HIGH>, <&mux0 2 GPIO_ACTIVE_HIGH>, <&mux0 3 GPIO_ACTIVE_HIGH>, <&mux0 4 GPIO_ACTIVE_HIGH>, <&mux0 5 GPIO_ACTIVE_HIGH>, <&mux0 6 GPIO_ACTIVE_HIGH>, <&mux0 7 GPIO_ACTIVE_HIGH>, <&mux1 0 GPIO_ACTIVE_HIGH>, <&mux1 1 GPIO_ACTIVE_HIGH>, <&mux1 2 GPIO_ACTIVE_HIGH>, <&mux1 3 GPIO_ACTIVE_HIGH>, <&mux1 4 GPIO_ACTIVE_HIGH>, <&mux1 5 GPIO_ACTIVE_HIGH>, <&mux1 6 GPIO_ACTIVE_HIGH>;
        drain-gpios = <&pro_micro 10 GPIO_ACTIVE_HIGH>;
        power-gpios = <&pro_micro 15 GPIO_ACTIVE_LOW>;
        io-channels = <&adc 1>; /* logical channel 0 is reserved by the ZMK battery driver */
        strobe-input-masks = <0x0 0x2 0x4002 0x1001 0x6b73>;
        matrix-warm-up-us = <200>;
        matrix-relax-us = <10>;
        adc-read-settle-us = <5>;
        trigger-percentage = <50>;
        active-polling-interval-ms = <4>;
        idle-polling-interval-ms = <8>;
        sleep-polling-interval-ms = <12>;
        idle-after-secs = <5>;
        sleep-after-secs = <300>;
        dynamic-polling-interval;
    };
};

&adc {
    status = "okay";
    #address-cells = <1>;
    #size-cells = <0>;
    channel@1 {
        reg = <1>;
        zephyr,gain = "ADC_GAIN_1_6";
        zephyr,reference = "ADC_REF_INTERNAL";
        zephyr,acquisition-time = <ADC_ACQ_TIME(ADC_ACQ_TIME_MICROSECONDS, 10)>;
        zephyr,resolution = <12>;
        zephyr,input-positive = <NRF_SAADC_AIN0>; /* D19=P0.02. D18 is NOT an ADC pin on nice!nano! */
    };
};
&i2c0 { status = "disabled"; };
&spi1 { status = "disabled"; };
&uart0 { status = "disabled"; };
